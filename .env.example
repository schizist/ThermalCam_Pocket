# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# Primary network (e.g. home)
WIFI_SSID=YourNetworkName
WIFI_PASSWORD=YourPassword

# Optional second network (e.g. work) - the device joins whichever is in range
WIFI2_SSID=
WIFI2_PASSWORD=

# Fallback hotspot password used when neither network is found (min 8 chars)
AP_PASSWORD=dollhead

# ArduinoOTA password for wireless firmware uploads
OTA_PASSWORD=changeme
